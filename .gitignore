# Never commit other authors' mods: install them from mods/manifest.json
*.jar
*.jar.disabled

# Generated from your local EPCA jar by tools/gen_loot_overrides.py (closed-source data)
overrides/kubejs/data/epca/loot_tables/

# Personal or machine-specific instance files
minecraftinstance.json
options.txt
usercache.json
usernamecache.json
logs/
crash-reports/
saves/
screenshots/
essential/
/local/
# Oracle bridge folder: only the .keep placeholder ships (logs, telemetry and verdicts never do)
overrides/local/pne_oracle/*
!overrides/local/pne_oracle/.keep
*.bak-pne
*.log

# Python / editor noise
__pycache__/
*.pyc
.vscode/
.idea/

# Resonance build output (rendered WAVs and intermediate files; verified OGGs are copied into overrides)
tools/resonance/out/
# Oracle runtime files if the sidecar is run from the repo
oracle/**/*.ndjson
