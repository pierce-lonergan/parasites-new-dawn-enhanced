{
  "schema": 1,
  "title": "The Resonance: machine-readable DSP spec (TDD 2.3, 2.6; IMPLEMENTATION 5)",
  "notes": [
    "render.py reads this file, verify.py takes every target, tolerance and expected rate from it, gen_sounds_json.py takes categories, attenuation distances, subtitles and mode flags from it.",
    "The TDD numbers are pinned in tools/resonance/tdd_pins.py: suite resonance-tdd-pins fails when this file disagrees with them (documented deviations are listed there), and verify.py applies the comfort-mode class limits and the L3/L4 rate and depth caps from the pins, not from this file.",
    "Seed per asset: FNV-1a 32-bit over the UTF-8 bytes of '<slug>/<cls>_v<NN>' (equals pneCoreFnv1a for ASCII). Random streams: numpy default_rng([seed, k]); k = 0 plan (per-variant draws), 1-2 and 11-12 noise sources, 3 LP walk, 20+ level-walk attempts (render.py).",
    "Event id pne:res.<slug>.<cls>.v<NN>; sounds.json key res.<slug>.<cls>.v<NN>; file assets/pne/sounds/res/<slug>/<cls>_v<NN>.ogg.",
    "Additions to the TDD, each needed to meet a TDD gate, are marked 'added' with the reason.",
    "\"ship\": false marks a class the pack does not ship (the stereo beds hollow.bed_*: lead decision 1.3, IMPLEMENTATION.md section 5). render.py and verify.py still build and gate it into tools/resonance/out/; verify.py --install copies only shipped classes into overrides/ and writes only them into tools/resonance/manifest.json. tdd_pins.NOT_SHIPPED pins the exact set."
  ],
  "fs": 48000,
  "chain": {
    "G1": "synthesis, float64, 48 kHz, seed per asset",
    "G2_floor_hz": 30.0,
    "G3_dc_block": {"type": "butter_highpass", "order": 1, "hz": 5.0},
    "G4_sub_guard": {"type": "butter_highpass", "order": 4, "hz": 28.0, "single_pass_sosfilt": true},
    "G5_ultrasonic_guard": {"type": "butter_lowpass", "order": 8, "hz": 16000.0},
    "G6": "layer processing (classes below)",
    "G7_min_fade_s": 0.02,
    "G7_exempt": ["spike.a attack (25 ms, normal mode only)"],
    "G8": {"iterations": 3, "converge_lu": 0.05},
    "G9_limiter": {"ceiling_dbtp": -2.0, "lookahead_ms": 5.0, "release_ms": 50.0, "oversample": 4, "zero_gr_layers": ["L2", "L3", "L4"]},
    "G10_encode": {"format": "OGG", "subtype": "VORBIS", "compression_level": 0.3, "ogg_serial": "FNV-1a of the asset name & 0x7fffffff (page CRCs recomputed; makes the bytes reproducible)"},
    "G11": "decode with libsndfile; every gate runs on the decoded file"
  },
  "reference": {
    "ambientsounds_bed_median_lufs": -29.0,
    "ambientsounds_bed_source": "TDD 2.3.3 / Appendix B (measure_groups.py over the AmbientSounds 6.3.8 jar); tdd/asset_measurements.json holds the EPCA, Spore and vanilla references (medians -19.8, -15.0, -20.2 LUFS)",
    "reference_bed": "hollow dry synthesis (60% pink + 40% brown, LP 6 kHz BW2, -4 dB peak at 2.5 kHz), 20 s mono, no walks, seed 'hollow/reference', scaled to the AmbientSounds median",
    "whisper_geometry": {"vol": 0.55, "d": 6.03, "att": 32},
    "director_bed_geometry": {"d": 12.0, "att": 128, "file_lufs": -30.0},
    "tell_geometry": {"vol": 1.0, "d": 12.0, "att": 24},
    "director_placement": {"height": 12.0, "att": 128, "sprint_bps": 5.6, "walk_bps": 4.3},
    "leff": "L_eff = L_file + 20 log10(min(vol,1)) + 20 log10(max(eps, 1 - d / (max(vol,1) att)))"
  },
  "gates": {
    "V1": {"fs": 48000, "format": "OGG", "subtype": "VORBIS"},
    "V3": {"max_dbtp": -1.0, "max_sample_abs": 0.999},
    "V4": {"below_hz": 20.0, "max_db": -35.0},
    "V5": {"below_hz": 100.0, "max_share": 0.6},
    "V6": {"f0_tol_hz": 0.2, "min_depth": 0.7, "env_lp_hz": 60.0, "search_hz": [5.0, 60.0]},
    "V7": {"spacing_tol_hz": 0.2, "level_tol_db": 1.0, "rough_min_carrier_hz": 250.0},
    "V8": {"rate_tol_hz": 0.05, "env_lp_hz": 30.0, "search_hz": [0.5, 3.0], "harmonics": 3, "model_residual_max_db": -15.0,
           "depth_note": "added: the modulation depth m is measured on the decoded file by a least-squares fit onto the unmodulated carrier re-synthesised from the recorded seed (and carrier x pulse train); limits from tdd_pins (m <= 0.6, comfort m <= 0.3, rate 1.0-1.4 Hz, comfort <= 8 s)"},
    "V9": {"rate_tol_hz": 0.1, "min_depth": 0.85, "env_lp_hz": 60.0, "search_slow_hz": [0.25, 2.5], "search_tense_hz": [2.0, 10.0]},
    "V10": {"band_hz": [300.0, 3400.0], "tol_db": 1.0, "active_floor_db": 20.0},
    "V11": {"edge_s": 0.02, "min_edge_drop_db": 20.0, "director_max_s": 10.0},
    "V12": {"max_spread_lu": 3.0},
    "V13": {"static_pcm_max_bytes": 64000000, "pcm_bytes_per_sample": 2, "stream_above_s": 10.0, "max_streams_per_state": 4, "max_fall_db": 5.0},
    "V14": {"peaks": 5},
    "V15": {"normal": {"max_lu": 10.0, "window_s": 3.0}, "comfort": {"max_lu": 6.0, "window_s": 2.0}, "hop_s": 0.01, "min_span_s": 0.1,
            "min_span_note": "added: rises are measured over momentary windows that start after the onset fade; when those window starts span less than 0.1 s (a file shorter than about fade-in + 0.5 s, e.g. a 0.45 s tell) there is no in-file rise to measure, so V15 is reported as not applicable (never as a pass with full margin) and the onset step (M-max, catalog mmax) is the ledger's level-jump input (TDD 2.3.4)"},
    "V16": {"band_hz": [2000.0, 3200.0], "min_db": 6.0},
    "global_mmax_max": -13.0,
    "CE": {"rule": "comfort envelope rule (TDD 2.3.2): no comfort asset with an envelope rate above 2 Hz at a line depth above 0.5", "min_rate_hz": 2.0, "max_depth": 0.5, "env_lp_hz": 200.0, "search_hz": [2.0, 150.0], "norm_s": 0.5,
           "syllabic": {"model_residual_max_db": -12.0, "note": "L5: the syllabic AM (TDD: depth 0.45 passes) is measured per burst on the decoded file by a least-squares fit onto the same phrase re-synthesised without the AM; its depth must be <= max_depth. This part of CE is binding."},
           "pending_lead_decision": {"whisper.amb": "phrase-level burst gating reads above 2 Hz at depth > 0.5; TDD 2.3.2 counts only the syllabic AM (measured, binding)", "whisper.near": "as whisper.amb", "tell.a": "sub-second click train; L8 unchanged in comfort for fairness; no TDD exemption"},
           "pending_note": "these classes are measured and reported as PENDING (not as passes) until the lead records the decision in TDD 2.3.2 / IMPLEMENTATION 5; tdd_pins.PENDING_CE pins this exact list"}
  },
  "states": {
    "_comment": "Classes each director state may issue or reference (TDD 2.5.4, 2.3.3 L0). Used by V13 (streams per state).",
    "QUIET": ["hollow.bed_dry", "hollow.dry", "whisper.amb"],
    "UNEASE": ["hollow.bed_dry", "hollow.dry", "undertone.a", "beat.slow", "whisper.amb"],
    "DREAD": ["hollow.bed_dread", "hollow.dread", "undertone.a", "pulse.heartbeat", "pulse.flutter", "pulse.rough", "pulse.heartbeat_c", "beat.tense", "beat.slow", "whisper.near", "approach.n", "approach.c", "spike.a", "hollow.t_dry_muffled"],
    "PANIC": ["pulse.heartbeat", "pulse.heartbeat_c", "spike.a", "tell.a"],
    "RELEASE": ["hollow.bed_muffled", "hollow.muffled", "hollow.t_dread_muffled"]
  },
